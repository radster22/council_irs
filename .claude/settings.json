{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.uploads/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-checks.mjs"],
            "timeout": 600,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-checks.mjs"],
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
