# Copy to .env at the repository root. Keep real values in the ignored .env.
APP_ENV=development

# Local MySQL 8 database. URL-encode reserved characters in the password.
DATABASE_URL=mysql+pymysql://root:replace-me@localhost:3306/council_irs_db?charset=utf8mb4

# Generate a unique local secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-local-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# Frontend API endpoint for the local FastAPI server.
VITE_API_BASE_URL=http://localhost:8000
